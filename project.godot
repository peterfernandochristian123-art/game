; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Fighting to Zero"
config/description="Fast-paced 2D 1v1 mecha duel arcade fighting game with 90s retro 32-bit pixel art."
config/version="1.0.0"
run/main_scene="res://scenes/test_arena.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://scripts/core/event_bus.gd"
InputBuffer="*res://scripts/core/input_buffer.gd"

[layer_names]

2d_physics/layer_1="World"
2d_physics/layer_2="Hurtbox"
2d_physics/layer_3="StrikeHitbox"
2d_physics/layer_4="GrabHitbox"
2d_physics/layer_5="LedgeSensor"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"

